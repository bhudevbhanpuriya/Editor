# Judge0 execution backend.
#
# Defaults to the public https://ce.judge0.com endpoint, which is heavily rate
# limited and will return HTTP 429 under any real usage. For anything beyond
# local experimentation, point these at a RapidAPI subscription or your own
# self-hosted Judge0 instance.
#
# Copy to `.env.local` and fill in. Note that Create React App inlines these
# values into the client bundle, so they are public — never put a secret here
# that you would not hand to any visitor. A server-side proxy is the right
# place for a real key.

REACT_APP_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
REACT_APP_JUDGE0_HOST=judge0-ce.p.rapidapi.com
REACT_APP_JUDGE0_KEY=

# Collaboration (Yjs WebSocket server — see server/README.md).
#
# `npm run dev` starts the server on :1234 alongside the React dev server, so
# the default works locally with no configuration.
#
# In production this MUST be a wss:// URL: the site is served over HTTPS, and a
# ws:// URL is blocked as mixed content with an error that looks like a generic
# network failure. The server cannot run on Vercel — it needs a host that keeps
# a process alive (Fly, Railway, Render).
#
# A production build with REACT_APP_COLLAB_WS_URL unset has collaboration
# turned off (no Share button, no socket), so a frontend-only deploy works
# without the server. Set the URL to turn it on.
#
# Set REACT_APP_COLLAB_ENABLED=false to hide the Share button entirely and
# never open a socket, even when a URL is set.

REACT_APP_COLLAB_WS_URL=ws://localhost:1234
REACT_APP_COLLAB_ENABLED=true
